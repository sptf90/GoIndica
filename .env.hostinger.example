# Copy to .env.hostinger (ignored by Git). Never paste credentials into chat.
NEXT_PUBLIC_APP_URL=https://your-domain
MYSQL_HOST=your-database-host
MYSQL_PORT=3306
MYSQL_DATABASE=your-database
MYSQL_USER=your-user
MYSQL_PASSWORD=your-password
MYSQL_POOL_SIZE=5
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your-email
SMTP_PASSWORD=your-mailbox-password
EMAIL_FROM=GoIndica <your-email>
NEXT_PUBLIC_SUPPORT_EMAIL=your-email
CRON_SECRET=
# Deployment access, if available. The application does not use these variables.
HOSTINGER_SSH_HOST=
HOSTINGER_SSH_PORT=65002
HOSTINGER_SSH_USER=
# Optional path to an existing SSH private key (do not copy the key into the repository).
HOSTINGER_SSH_KEY_PATH=
