# Hostinger Node.js app: Node 24, build npm run build, start npm start.
NEXT_PUBLIC_APP_URL=http://localhost:3000
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your-database
MYSQL_USER=your-user
MYSQL_PASSWORD=your-password
MYSQL_POOL_SIZE=5
# Enable only when the database endpoint supports TLS with a trusted certificate.
MYSQL_SSL=false
# Hostinger mailbox used for confirmation, recovery, email changes and reminders.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=your-email
SMTP_PASSWORD=your-mailbox-password
EMAIL_FROM=GoIndica <your-email>
NEXT_PUBLIC_SUPPORT_EMAIL=contato@example.com
PILOT_CITY_ID=3549805
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Google Cloud: enable Places API (New) and billing. Server-only key.
GOOGLE_PLACES_API_KEY=
