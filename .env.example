# Public application URL. Set the real HTTPS domain in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Optional Google login. Email/password login works independently of this provider.
GOOGLE_OAUTH_ENABLED=false
# Server only. Never prefix these names with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
GOOGLE_PLACES_API_KEY=your-server-places-api-key
# Optional: dedicated test PostgreSQL. Otherwise integration tests use ephemeral embedded PostgreSQL.
TEST_DATABASE_URL=
# Optional live E2E environment (isolated Supabase + Google provider + Places configured).
E2E_BASE_URL=http://localhost:3000
# Public support address: configure the actual operator's contact before public launch.
NEXT_PUBLIC_SUPPORT_EMAIL=contato@example.com

# Optional pilot municipality (IBGE). Default: São José do Rio Preto/SP.
PILOT_CITY_ID=3549805
# Optional email reminders (explicit opt-in). Configure a verified Resend sender.
RESEND_API_KEY=
EMAIL_FROM=
# At least 32 random characters. Scheduler calls POST /api/cron/reminders.
CRON_SECRET=
