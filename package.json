{
  "name": "goindica",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:test": "tsx scripts/test-database.ts",
    "banco:migrar": "npx --yes supabase db push",
    "cities:update": "tsx scripts/import-cities.ts",
    "format": "prettier --write src tests scripts docs \"*.ts\" \"*.mjs\" \"*.json\" README.md",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "db:types": "tsx scripts/generate-db-types.ts",
    "db:types:check": "tsx scripts/generate-db-types.ts --check",
    "verify:scale": "tsx scripts/verify-scale.ts",
    "verify:recovery": "tsx scripts/verify-recovery.ts",
    "test:e2e:cross": "playwright test --config playwright.cross-browser.config.ts",
    "tools:postgrest": "tsx scripts/install-postgrest.ts",
    "verify:postgrest": "tsx scripts/verify-postgrest.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.8",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsqr": "^1.4.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "type": "module",
  "allowScripts": {
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
}
