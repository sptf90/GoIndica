{
  "name": "goindica",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:test": "npm run test:integration",
    "banco:migrar": "tsx scripts/migrate-mysql.ts",
    "cities:update": "tsx scripts/import-cities.ts",
    "banco:admin": "tsx scripts/promote-admin.ts",
    "hostinger:pacote": "node scripts/package-hostinger.mjs",
    "cron:lembretes": "tsx scripts/cron-reminders.ts",
    "hostinger:fonte": "node scripts/package-source.mjs",
    "banco:sql": "tsx scripts/export-mysql-sql.ts",
    "banco:limpar": "tsx scripts/cleanup-mysql.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "mysql2": "^3.24.6",
    "next": "^16.3.8",
    "nodemailer": "^10.1.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsqr": "^1.4.0",
    "mailparser": "^3.9.39",
    "smtp-server": "^3.19.22",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
